{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "brands-route": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/brands/{**catch-all}" }
      },
      "sneakers-route": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/sneakers/{**catch-all}" }
      },
      "inventory-route": {
        "ClusterId": "inventory",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "ordering",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "inventory": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } },
      "ordering": { "Destinations": { "d1": { "Address": "http://localhost:5004/" } } }
    }
  }
}
